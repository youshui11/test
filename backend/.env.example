# 复制为 backend/.env；JWT_SECRET 必须替换为至少 32 字符的随机值。
DATABASE_URL=postgresql+asyncpg://wd_admin:wd_123@localhost:5432/wendang
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:7777","http://127.0.0.1:7777","http://localhost:5173"]
# 聊天和 embedding 可以使用不同服务；均需支持对应 OpenAI API。
# server：调用 agent/server.py 的 deepseek_agent；env：使用以下 LLM_*。
LLM_CONFIG_SOURCE=server
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai
EMBEDDING_API_KEY=
# 可选兼容：EMBEDDING_API_KEY 为空时回退 OPENAI_API_KEY。
OPENAI_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
MODEL_TIMEOUT_SECONDS=120
# 默认由 PD 按需调用 CX/QWJS，不在聊天前自动检索；true 可回滚旧流程。
CHAT_PRERETRIEVAL_ENABLED=false
# 导入资料：50 MB、转换120秒、单任务600秒、最多同时处理2份。
MAX_INGEST_BYTES=52428800
INGEST_CONCURRENCY=2
CONVERTER_TIMEOUT_SECONDS=120
INGEST_TIMEOUT_SECONDS=600
