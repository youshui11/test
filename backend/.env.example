# 复制为 backend/.env；JWT_SECRET 必须替换为至少 32 字符的随机值。
DATABASE_URL=postgresql+asyncpg://wd_admin:wd_123@localhost:5432/wendang
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:7777","http://127.0.0.1:7777","http://localhost:5173"]
# 聊天和 embedding 可以使用不同服务；均需支持对应 OpenAI API。
# server：调用 agent/server.py 的 deepseek_agent；env：使用以下 LLM_*。
LLM_CONFIG_SOURCE=server
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
MODEL_TIMEOUT_SECONDS=120
